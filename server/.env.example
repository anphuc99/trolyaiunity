# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mimi_learn

# Authentication
JWT_SECRET=change-me-to-a-random-secret
REGISTRATION_TOKEN=

# AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=4000
HOST=localhost
NODE_ENV=development

# Storage
CHAT_HISTORY_DIR=data/chat-history

# TypeORM
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# TLS (Corporate Proxy)
OPENAI_TLS_INSECURE=false
# OPENAI_TLS_CA_CERT_PATH=
# OPENAI_TLS_CA_CERT_BASE64=
